# ============================================
# 简牍后台管理系统 - Supabase 配置文件
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写你的 Supabase 项目信息
# 3. 启动服务器
# ============================================

# --------------------------------------------
# Supabase 配置（必填）
# --------------------------------------------
# 获取方式：
# 1. 打开 https://supabase.com/dashboard
# 2. 选择你的项目 (JianDu)
# 3. 进入 Settings → API
# 4. 复制 Project URL 和 anon/public key

# Supabase 项目 URL (示例：https://hyibnmdnzheyvhupjcfr.supabase.co)
SUPABASE_URL=https://hyibnmdnzheyvhupjcfr.supabase.co

# Supabase API Key (anon/public key，不是 service_role key)
# ⚠️ 注意：使用 anon key 即可，不要使用 service_role key（那会绕过 RLS 安全策略）
SUPABASE_KEY=your_supabase_anon_key_here

# --------------------------------------------
# JWT 配置（必填）
# --------------------------------------------
# 用于生成登录 Token 的密钥
# 生产环境请使用强随机字符串（可以用 https://randomkeygen.com/ 生成）
JWT_SECRET=jiandu_supabase_jwt_secret_change_me_in_production

# Token 有效期（默认 24 小时）
JWT_EXPIRES_IN=24h

# --------------------------------------------
# 服务器配置（可选）
# --------------------------------------------
# 服务端口
PORT=3000

# --------------------------------------------
# 完成配置后：
# 1. 在 Supabase Dashboard → SQL Editor 运行 supabase-schema.sql
# 2. 运行 npm install 安装依赖
# 3. 运行 npm start 启动服务器
# --------------------------------------------
